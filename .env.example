BACKEND_API_URL=http://localhost:8080/api/v1
AI_API_URL=http://localhost:8000/api/v1
BACKEND_OPENAPI_URL=http://localhost:8080/v3/api-docs
AI_OPENAPI_URL=http://localhost:8000/openapi.json
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser OAuth client ID from Google Cloud Console. Leave blank to hide the
# Google button until the backend GOOGLE_CLIENT_ID is configured as well.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Stripe publishable key for the browser payment form. Keep the secret key on
# the backend only; leave blank when Stripe is not configured in the environment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
